# ─────────────────────────────────────────────────────────────────────────────
# Configuration de déploiement — Livret d'apprentissage GRETA Lyon Métropole
# Architecture : Option A — conteneur nginx:alpine derrière Traefik existant
# ─────────────────────────────────────────────────────────────────────────────
#
# Copier ce fichier en `.env.deploy` puis remplir les valeurs réelles.
# Le fichier `.env.deploy` ne doit JAMAIS être commité (voir .gitignore).
#
# Tous les scripts (setup-vps.sh, deploy.sh, verifier-vps.sh) lisent
# ces variables. Ne pas mettre d'espaces autour du signe `=`.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Domaine DuckDNS ───────────────────────────────────────────────────────
# Sous-domaine sans le suffixe .duckdns.org (validé : livret-glm)
DUCKDNS_SUBDOMAIN=livret-glm

# ── 2. VPS Hostinger ─────────────────────────────────────────────────────────
# IP publique du VPS
VPS_IP=69.62.107.157
# Utilisateur SSH (root pour l'instant — voir README pour bascule en clé SSH)
VPS_USER=root
# Port SSH
VPS_SSH_PORT=22

# ── 3. Basic Auth (accès restreint à la démo) ────────────────────────────────
# Identifiant Basic Auth partagé à la direction
BASIC_AUTH_USER=demo
# Mot de passe Basic Auth (fort, à partager via canal sécurisé)
# Le hash bcrypt est généré par setup-vps.sh — pas besoin de le calculer ici.
BASIC_AUTH_PASSWORD=

# ── 4. Application ───────────────────────────────────────────────────────────
# Chemin distant qui sert de web root (bind-mount dans le conteneur nginx)
REMOTE_PATH=/var/www/livret/
# Nom du build local (par défaut Vite : dist)
LOCAL_BUILD_DIR=dist

# ─────────────────────────────────────────────────────────────────────────────
# Notes :
#  - Pas de variable LETSENCRYPT_EMAIL : le certificat est géré par le Traefik
#    déjà en place sur le VPS (résolveur ACME `mytlschallenge`, email partagé
#    avec les autres projets dans /docker/n8n/.env).
#  - Pas de DUCKDNS_TOKEN : l'IP du VPS Hostinger est statique, le sous-domaine
#    livret-glm.duckdns.org est créé une fois manuellement sur duckdns.org et
#    pointé vers 69.62.107.157.
#  - Le réseau Docker utilisé est `n8n_default` (celui de Traefik).
# ─────────────────────────────────────────────────────────────────────────────
